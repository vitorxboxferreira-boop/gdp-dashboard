{
  "name": "agency-ai-sdr",
  "version": "0.1.0",
  "private": true,
  "description": "Agency AI SDR \u2014 prospec\u00e7\u00e3o, qualifica\u00e7\u00e3o e negocia\u00e7\u00e3o comercial para ag\u00eancia de sites.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash tests/db/run.sh",
    "test:all": "npm run typecheck && npm run test && npm run test:db && npm run test:integration",
    "test:integration": "vitest run tests/integration",
    "check:env": "node scripts/check-env.mjs",
    "check:env:prod": "node scripts/check-env.mjs --target=production",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
