# =============================================================================
# Agency AI SDR — variáveis de ambiente (MODELO, sem credenciais reais)
# Copie para .env.local (desenvolvimento). Em produção, configure na Vercel.
# Use projetos/chaves DIFERENTES para desenvolvimento e produção.
# =============================================================================

# development | staging | production  (exibido no painel; alerta se houver mistura)
APP_ENV=development

# --- Supabase (Fase 1) -------------------------------------------------------
# Públicas (vão para o navegador): somente URL e chave publicável/anon.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-DEV.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Projetos antigos: NEXT_PUBLIC_SUPABASE_ANON_KEY também é aceita.

# PRIVADA — apenas servidor. Usada para executar os agentes pelo painel.
SUPABASE_SECRET_KEY=
# (alternativa legada) SUPABASE_SERVICE_ROLE_KEY=

# --- Google Places API (New) (Fase 1) ----------------------------------------
# PRIVADA. Restrinja a chave à "Places API (New)" e, se possível, por IP.
# Também deve ser definida como segredo da Edge Function (supabase secrets set).
# A integração só é usada após o admin habilitá-la em Configurações.
GOOGLE_PLACES_API_KEY=

# --- Rotinas programadas (Fase 5) --------------------------------------------
# Segredo compartilhado entre Supabase Cron (Vault) e a Edge Function agent-runner.
# Gere com: openssl rand -hex 32   (mínimo 32 caracteres)
CRON_SECRET=

# --- Anthropic (Fase 3 — ainda não utilizada) --------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- WhatsApp Business Platform / Cloud API (Fase 2 — ainda não utilizada) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Política de privacidade (públicas) --------------------------------------
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_DOCUMENT=
NEXT_PUBLIC_PRIVACY_EMAIL=
